import { useMemo, useState } from "react";
import { toast } from "sonner";

const initialRound32 = [
  { id: "r32_1", home: "الفريق 1", away: "الفريق 2" },
  { id: "r32_2", home: "الفريق 3", away: "الفريق 4" },
  { id: "r32_3", home: "الفريق 5", away: "الفريق 6" },
  { id: "r32_4", home: "الفريق 7", away: "الفريق 8" },
  { id: "r32_5", home: "الفريق 9", away: "الفريق 10" },
  { id: "r32_6", home: "الفريق 11", away: "الفريق 12" },
  { id: "r32_7", home: "الفريق 13", away: "الفريق 14" },
  { id: "r32_8", home: "الفريق 15", away: "الفريق 16" },
  { id: "r32_9", home: "الفريق 17", away: "الفريق 18" },
  { id: "r32_10", home: "الفريق 19", away: "الفريق 20" },
  { id: "r32_11", home: "الفريق 21", away: "الفريق 22" },
  { id: "r32_12", home: "الفريق 23", away: "الفريق 24" },
  { id: "r32_13", home: "الفريق 25", away: "الفريق 26" },
  { id: "r32_14", home: "الفريق 27", away: "الفريق 28" },
  { id: "r32_15", home: "الفريق 29", away: "الفريق 30" },
  { id: "r32_16", home: "الفريق 31", away: "الفريق 32" },
];

function buildNextRound(previousWinners, prefix) {
  const matches = [];

  for (let i = 0; i < previousWinners.length; i += 2) {
    matches.push({
      id: `${prefix}_${i / 2 + 1}`,
      home: previousWinners[i] || "الفائز",
      away: previousWinners[i + 1] || "الفائز",
    });
  }

  return matches;
}

function MatchCard({ match, selected, onSelect }) {
  return (
    <div className="rounded-2xl border border-white/10 bg-white/5 p-4 shadow-lg">
      <div className="mb-3 text-center text-sm text-white/60">
        {match.id}
      </div>

      <div className="grid grid-cols-2 gap-3">
        <button
          onClick={() => onSelect(match.id, match.home)}
          disabled={!match.home || match.home === "الفائز"}
          className={`rounded-xl px-3 py-4 text-sm font-bold transition ${
            selected === match.home
              ? "bg-yellow-400 text-black"
              : "bg-slate-800 text-white hover:bg-slate-700"
          } disabled:opacity-40`}
        >
          {match.home}
        </button>

        <button
          onClick={() => onSelect(match.id, match.away)}
          disabled={!match.away || match.away === "الفائز"}
          className={`rounded-xl px-3 py-4 text-sm font-bold transition ${
            selected === match.away
              ? "bg-yellow-400 text-black"
              : "bg-slate-800 text-white hover:bg-slate-700"
          } disabled:opacity-40`}
        >
          {match.away}
        </button>
      </div>
    </div>
  );
}

function RoundSection({ title, subtitle, matches, selections, onSelect }) {
  return (
    <section className="mb-8">
      <div className="mb-4">
        <h2 className="text-xl font-black text-yellow-300">{title}</h2>
        {subtitle && <p className="mt-1 text-sm text-white/60">{subtitle}</p>}
      </div>

      <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
        {matches.map((match) => (
          <MatchCard
            key={match.id}
            match={match}
            selected={selections[match.id]}
            onSelect={onSelect}
          />
        ))}
      </div>
    </section>
  );
}

export default function Challenge() {
  const [round32Selections, setRound32Selections] = useState({});
  const [round16Selections, setRound16Selections] = useState({});
  const [quarterSelections, setQuarterSelections] = useState({});
  const [semiSelections, setSemiSelections] = useState({});
  const [finalSelections, setFinalSelections] = useState({});

  const round32Winners = initialRound32
    .map((m) => round32Selections[m.id])
    .filter(Boolean);

  const round16Matches = useMemo(() => {
    return buildNextRound(
      initialRound32.map((m) => round32Selections[m.id]),
      "r16"
    );
  }, [round32Selections]);

  const round16Winners = round16Matches
    .map((m) => round16Selections[m.id])
    .filter(Boolean);

  const quarterMatches = useMemo(() => {
    return buildNextRound(
      round16Matches.map((m) => round16Selections[m.id]),
      "qf"
    );
  }, [round16Matches, round16Selections]);

  const quarterWinners = quarterMatches
    .map((m) => quarterSelections[m.id])
    .filter(Boolean);

  const semiMatches = useMemo(() => {
    return buildNextRound(
      quarterMatches.map((m) => quarterSelections[m.id]),
      "sf"
    );
  }, [quarterMatches, quarterSelections]);

  const semiWinners = semiMatches
    .map((m) => semiSelections[m.id])
    .filter(Boolean);

  const finalMatches = useMemo(() => {
    return buildNextRound(
      semiMatches.map((m) => semiSelections[m.id]),
      "final"
    );
  }, [semiMatches, semiSelections]);

  const champion = finalMatches[0] ? finalSelections[finalMatches[0].id] : "";

  const selectRound32 = (id, team) => {
    setRound32Selections((prev) => ({ ...prev, [id]: team }));
    setRound16Selections({});
    setQuarterSelections({});
    setSemiSelections({});
    setFinalSelections({});
  };

  const selectRound16 = (id, team) => {
    setRound16Selections((prev) => ({ ...prev, [id]: team }));
    setQuarterSelections({});
    setSemiSelections({});
    setFinalSelections({});
  };

  const selectQuarter = (id, team) => {
    setQuarterSelections((prev) => ({ ...prev, [id]: team }));
    setSemiSelections({});
    setFinalSelections({});
  };

  const selectSemi = (id, team) => {
    setSemiSelections((prev) => ({ ...prev, [id]: team }));
    setFinalSelections({});
  };

  const selectFinal = (id, team) => {
    setFinalSelections((prev) => ({ ...prev, [id]: team }));
  };

  const handleSave = async () => {
    if (!champion) {
      toast.error("اختر البطل أولاً 👑");
      return;
    }

    const prediction = {
      challengeId: "worldcup2026_round32",
      round32: round32Selections,
      round16: round16Selections,
      quarterFinals: quarterSelections,
      semiFinals: semiSelections,
      final: finalSelections,
      champion,
      savedAt: new Date().toISOString(),
    };

    console.log("Challenge prediction:", prediction);

    toast.success(`تم حفظ تحديك 👑 بطلك المتوقع: ${champion}`);
  };

  const shareChallenge = async () => {
    const text = champion
      ? `أنا توقعت بطل تحدي ملك التوقعات 👑 وهو: ${champion}\nشارك وتحدى معي:\nhttps://king-of-predictions-17019.web.app/challenge`
      : `شارك في تحدي ملك التوقعات 👑\nhttps://king-of-predictions-17019.web.app/challenge`;

    try {
      if (navigator.share) {
        await navigator.share({
          title: "تحدي ملك التوقعات",
          text,
        });
      } else {
        await navigator.clipboard.writeText(text);
        toast.success("تم نسخ رابط التحدي");
      }
    } catch {
      toast.error("تعذر مشاركة التحدي");
    }
  };

  return (
    <main dir="rtl" className="mx-auto max-w-6xl px-4 py-6">
      <div className="mb-8 rounded-3xl border border-yellow-400/30 bg-gradient-to-br from-slate-900 via-slate-950 to-black p-5 text-center shadow-2xl">
        <div className="mb-2 text-5xl">👑</div>

        <h1 className="text-3xl font-black text-yellow-300">
          تحدي ملك التوقعات
        </h1>

        <p className="mt-2 text-white/70">
          ابدأ من دور الـ32 وتوقع طريق البطل حتى النهائي
        </p>

        {champion && (
          <div className="mt-5 rounded-2xl bg-yellow-400 px-4 py-3 text-black">
            <div className="text-sm font-bold">بطلك المتوقع</div>
            <div className="text-2xl font-black">🏆 {champion}</div>
          </div>
        )}

        <div className="mt-5 flex flex-col gap-3 sm:flex-row sm:justify-center">
          <button
            onClick={handleSave}
            className="rounded-2xl bg-yellow-400 px-6 py-3 font-black text-black shadow-lg transition hover:bg-yellow-300"
          >
            حفظ التحدي
          </button>

          <button
            onClick={shareChallenge}
            className="rounded-2xl bg-white/10 px-6 py-3 font-black text-white transition hover:bg-white/20"
          >
            مشاركة التحدي
          </button>
        </div>
      </div>

      <RoundSection
        title="دور الـ32"
        subtitle={`${round32Winners.length} من 16 اختيارات مكتملة`}
        matches={initialRound32}
        selections={round32Selections}
        onSelect={selectRound32}
      />

      <RoundSection
        title="دور الـ16"
        subtitle={`${round16Winners.length} من 8 اختيارات مكتملة`}
        matches={round16Matches}
        selections={round16Selections}
        onSelect={selectRound16}
      />

      <RoundSection
        title="ربع النهائي"
        subtitle={`${quarterWinners.length} من 4 اختيارات مكتملة`}
        matches={quarterMatches}
        selections={quarterSelections}
        onSelect={selectQuarter}
      />

      <RoundSection
        title="نصف النهائي"
        subtitle={`${semiWinners.length} من 2 اختيارات مكتملة`}
        matches={semiMatches}
        selections={semiSelections}
        onSelect={selectSemi}
      />

      <RoundSection
        title="النهائي"
        subtitle={champion ? `البطل: ${champion}` : "اختر البطل"}
        matches={finalMatches}
        selections={finalSelections}
        onSelect={selectFinal}
      />
    </main>
  );
}
