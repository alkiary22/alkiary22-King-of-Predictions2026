import { useMemo } from "react";
import { useParams } from "react-router-dom";
import competitions from "@/data/competitions";
import { ArrowRight, CalendarDays, Trophy, Users, BarChart3 } from "lucide-react";

export default function CompetitionPage() {

  const { id } = useParams();

  const competition = useMemo(
    () => competitions.find(c => c.id === id),
    [id]
  );

  if (!competition) {
    return (
      <div className="min-h-screen bg-base flex items-center justify-center text-white">
        البطولة غير موجودة
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-base text-white">

      <div
        className="h-56 relative overflow-hidden"
        style={{
          background: `linear-gradient(135deg, ${competition.color}, #0f0f0f)`
        }}
      >

        <div className="absolute inset-0 bg-black/40"/>

        <div className="relative h-full flex flex-col items-center justify-center">

          <img
            src={competition.image}
            className="w-28 h-28 object-contain bg-white rounded-3xl p-3 shadow-xl"
          />

          <h1 className="mt-4 text-3xl font-black">
            {competition.title}
          </h1>

          <p className="text-white/80">
            موسم {competition.season}
          </p>

        </div>

      </div>

      <div className="px-4 py-6">

        <div className="grid grid-cols-2 gap-4">

          <button className="rounded-2xl bg-[#191919] border border-white/10 p-5">
            <CalendarDays className="mb-3 text-[#D4AF37]"/>
            <div className="font-black">المباريات</div>
          </button>

          <button className="rounded-2xl bg-[#191919] border border-white/10 p-5">
            <BarChart3 className="mb-3 text-[#D4AF37]"/>
            <div className="font-black">الترتيب</div>
          </button>

          <button className="rounded-2xl bg-[#191919] border border-white/10 p-5">
            <Users className="mb-3 text-[#D4AF37]"/>
            <div className="font-black">الفرق</div>
          </button>

          <button className="rounded-2xl bg-[#191919] border border-white/10 p-5">
            <Trophy className="mb-3 text-[#D4AF37]"/>
            <div className="font-black">الهدافون</div>
          </button>

        </div>

      </div>

    </div>
  );

}
