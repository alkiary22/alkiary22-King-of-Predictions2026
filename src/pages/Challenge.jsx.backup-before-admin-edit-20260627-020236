function buildNextRound(previousWinners, prefix, label, dates) {
  const matches = [];

  for (let i = 0; i < previousWinners.length; i += 2) {
    matches.push({
      id: `${prefix}_${i / 2 + 1}`,
      date: dates?.[i / 2]?.date || label,
      time: dates?.[i / 2]?.time || "",
      home: previousWinners[i] || placeholderTeam(label),
      away: previousWinners[i + 1] || placeholderTeam(label),
    });
  }

  return matches;
}

function TeamRow({ team, active, disabled, onClick }) {
  return (
    <button
      type="button"
      disabled={disabled}
      onClick={onClick}
      className={`group flex w-full items-center justify-between gap-3 border-t border-white/10 px-3 py-3 text-right transition ${
        active
          ? "bg-yellow-400 text-black"
          : disabled
          ? "bg-[#285775]/55 text-white/35"
          : "bg-[#1f5575]/90 text-white hover:bg-[#2b6c91]"
      }`}
    >
      <span
        className={`flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs ${
          active
            ? "bg-black text-yellow-300"
            : disabled
            ? "bg-white/10 text-white/20"
            : "bg-white/15 text-white/60 group-hover:bg-white/25"
        }`}
      >
        ✓
      </span>

      <span className="min-w-0 flex-1 truncate text-sm font-black">
        {team.name}
      </span>

      <span className="text-3xl leading-none">{team.flag}</span>
    </button>
  );
}

function BracketMatch({ match, selected, onSelect, muted }) {
  const homeDisabled = match.home?.placeholder;
  const awayDisabled = match.away?.placeholder;

  return (
    <div
      className={`relative w-72 shrink-0 overflow-hidden rounded-xl border shadow-2xl ${
        muted
          ? "border-white/10 opacity-55"
          : "border-cyan-300/20 shadow-black/30"
      }`}
    >
      <div className="bg-[#073d5f]/95 px-4 py-3 text-right">
        <div className="text-sm font-black text-white">{match.date}</div>
        {match.time && (
          <div className="mt-0.5 text-xs font-semibold text-white/75">
            {match.time}
          </div>
        )}
      </div>

      <TeamRow
        team={match.home}
        active={selected?.name === match.home?.name}
        disabled={homeDisabled}
        onClick={() => onSelect(match.id, match.home)}
      />

      <TeamRow
        team={match.away}
        active={selected?.name === match.away?.name}
        disabled={awayDisabled}
        onClick={() => onSelect(match.id, match.away)}
      />
    </div>
  );
}

function RoundColumn({
  title,
  count,
  total,
  matches,
  selections,
  onSelect,
  topClass,
  gapClass,
  muted,
}) {
  return (
    <div className={`flex w-80 shrink-0 flex-col ${topClass || ""}`}>
      <div className="sticky top-0 z-10 mb-5 rounded-b-2xl bg-[linear-gradient(135deg,#f7d774,#b98723)] px-5 py-4 text-center shadow-xl">
        <div className="text-lg font-black text-black">{title}</div>
        <div className="mt-1 text-xs font-bold text-black/70">
          {count} من {total}
        </div>
      </div>

      <div className={`flex flex-col ${gapClass || "gap-4"}`}>
        {matches.map((match) => (
          <BracketMatch
            key={match.id}
            match={match}
            selected={selections[match.id]}
            onSelect={onSelect}
            muted={muted}
          />
        ))}
      </div>
    </div>
  );
}

