import { useEffect, useRef, useState } from "react";
import api from "@/lib/api";
import {
  CalendarDays,
  BarChart3,
  Shield,
  Goal,
} from "lucide-react";

import CompetitionMatches from "./CompetitionMatches";
import CompetitionStandings from "./CompetitionStandings";
import CompetitionTeams from "./CompetitionTeams";
import CompetitionScorers from "./CompetitionScorers";

const FIXED_2026_LEAGUES = [1, 39, 140, 135, 78, 61];

function getSeason(item) {
  const id = Number(item?.id);

  if (id === 2) {
    return 2025;
  }

  if (FIXED_2026_LEAGUES.includes(id)) {
    return 2026;
  }

  return (
    item?.effective_season ||
    item?.current_season ||
    item?.season ||
    2026
  );
}

function getSeasonLabel(item) {
  if (Number(item?.id) === 2) {
    return "2025/2026";
  }

  return String(getSeason(item));
}

const TABS = [
  {
    id: "matches",
    label: "الجدول",
    icon: CalendarDays,
  },
  {
    id: "standings",
    label: "ترتيب الدوري",
    icon: BarChart3,
  },
  {
    id: "teams",
    label: "الفرق",
    icon: Shield,
  },
  {
    id: "scorers",
    label: "هدافون",
    icon: Goal,
  },
];

export default function CompetitionGrid() {
  const leagueScrollRef = useRef(null);

  const [competitions, setCompetitions] = useState([]);
  const [selectedId, setSelectedId] = useState(null);
  const [activeTab, setActiveTab] = useState("matches");

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    let mounted = true;

    async function loadCompetitions() {
      try {
        setLoading(true);
        setError("");

        const { data } = await api.get("/competitions");

        if (!mounted) return;

        const list = (
          Array.isArray(data) ? data : []
        ).map((item) => {
          const season = getSeason(item);

          return {
            ...item,
            id: String(item.id),
            apiLeagueId: Number(item.id),
            title: item.name_ar || item.name_en,
            name_ar: item.name_ar || item.name_en,
            name_en: item.name_en,
            season,
            current_season: season,
            effective_season: season,
            seasonLabel: getSeasonLabel(item),
            image: item.logo,
            logo: item.logo,
            country:
              item.country_ar ||
              item.country ||
              "",
          };
        });

        setCompetitions(list);

        if (list.length > 0) {
          setSelectedId(list[0].id);
        }
      } catch (e) {
        if (!mounted) return;

        setError(
          e?.response?.data?.detail ||
            e?.message ||
            "تعذر تحميل البطولات"
        );
      } finally {
        if (mounted) {
          setLoading(false);
        }
      }
    }

    loadCompetitions();

    return () => {
      mounted = false;
    };
  }, []);

  const selectedCompetition =
    competitions.find(
      (competition) =>
        competition.id === selectedId
    ) || competitions[0];

  function selectCompetition(competition, event) {
    setSelectedId(competition.id);
    setActiveTab("matches");

    event?.currentTarget?.scrollIntoView({
      behavior: "smooth",
      block: "nearest",
      inline: "center",
    });
  }

  function renderContent() {
    if (!selectedCompetition) {
      return null;
    }

    switch (activeTab) {
      case "standings":
        return (
          <CompetitionStandings
            competition={selectedCompetition}
          />
        );

      case "teams":
        return (
          <CompetitionTeams
            competition={selectedCompetition}
          />
        );

      case "scorers":
        return (
          <CompetitionScorers
            competition={selectedCompetition}
          />
        );

      default:
        return (
          <CompetitionMatches
            competition={selectedCompetition}
          />
        );
    }
  }

  if (loading) {
    return (
      <div className="py-16 text-center text-zinc-400">
        جاري تحميل البطولات...
      </div>
    );
  }

  if (error) {
    return (
      <div className="rounded-2xl border border-red-500/20 bg-red-500/10 p-5 text-center text-red-300">
        {error}
      </div>
    );
  }

  if (competitions.length === 0) {
    return (
      <div className="py-16 text-center text-zinc-500">
        لا توجد بطولات متاحة
      </div>
    );
  }

  return (
    <div
      dir="rtl"
      className="w-full"
    >
      <div
        ref={leagueScrollRef}
        className="
          flex
          items-center
          gap-2
          overflow-x-auto
          overscroll-x-contain
          px-1
          py-2
          scrollbar-hide
          [-webkit-overflow-scrolling:touch]
        "
      >
        {competitions.map((competition) => {
          const active =
            competition.id ===
            selectedCompetition?.id;

          return (
            <button
              key={competition.id}
              type="button"
              onClick={(event) =>
                selectCompetition(
                  competition,
                  event
                )
              }
              className={`
                shrink-0
                h-[58px]
                min-w-[176px]
                max-w-[225px]
                rounded-[18px]
                border
                px-3
                flex
                items-center
                justify-center
                gap-2.5
                transition-all
                duration-300
                ${
                  active
                    ? `
                      border-[#E6671D]
                      bg-gradient-to-l
                      from-[#54200F]
                      via-[#3B180D]
                      to-[#24130E]
                      shadow-[0_0_0_1px_rgba(230,103,29,0.20),0_0_24px_rgba(230,103,29,0.12)]
                    `
                    : `
                      border-[#1F2937]
                      bg-[#101722]
                    `
                }
              `}
            >
              <div
                className="
                  w-[40px]
                  h-[40px]
                  shrink-0
                  rounded-[12px]
                  bg-white
                  flex
                  items-center
                  justify-center
                  overflow-hidden
                "
              >
                <img
                  src={competition.image}
                  alt=""
                  className="
                    w-[31px]
                    h-[31px]
                    object-contain
                  "
                />
              </div>

              <span
                className={`
                  min-w-0
                  overflow-hidden
                  text-ellipsis
                  whitespace-nowrap
                  text-[15px]
                  font-black
                  ${
                    active
                      ? "text-white"
                      : "text-[#8D98AD]"
                  }
                `}
              >
                {competition.title}
              </span>
            </button>
          );
        })}
      </div>

      <div
        className="
          mt-6
          grid
          grid-cols-4
          gap-2
        "
      >
        {TABS.map((tab) => {
          const active = activeTab === tab.id;
          const Icon = tab.icon;

          return (
            <button
              key={tab.id}
              type="button"
              onClick={() =>
                setActiveTab(tab.id)
              }
              className={`
                min-w-0
                h-[68px]
                rounded-[22px]
                border
                flex
                flex-col
                items-center
                justify-center
                gap-1
                transition-all
                duration-300
                ${
                  active
                    ? `
                      border-[#3C8C68]
                      bg-[#245D46]
                      text-white
                      shadow-[inset_0_0_0_1px_rgba(79,190,139,0.16),0_8px_24px_rgba(0,0,0,0.22)]
                    `
                    : `
                      border-[#15261F]
                      bg-[#07100D]
                      text-[#687387]
                    `
                }
              `}
            >
              <Icon
                size={21}
                strokeWidth={2.3}
              />

              <span
                className="
                  w-full
                  px-1
                  text-center
                  text-[11px]
                  sm:text-[13px]
                  font-black
                  whitespace-nowrap
                "
              >
                {tab.label}
              </span>
            </button>
          );
        })}
      </div>

      <div className="mt-6">
        {renderContent()}
      </div>
    </div>
  );
}
