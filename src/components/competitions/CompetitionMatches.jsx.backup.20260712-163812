import { useEffect, useState } from "react";
import api from "@/lib/api";
import { CalendarDays } from "lucide-react";

export default function CompetitionMatches({ competition }) {

  const [matches,setMatches]=useState([]);
  const [loading,setLoading]=useState(true);

  useEffect(()=>{

    if(!competition?.id) return;

    let active=true;

    async function load(){

      try{

        const {data}=await api.get(
          `/competitions/${competition.id}/matches`
        );

        if(active){
          setMatches(data||[]);
        }

      }catch(e){
        console.error(e);
      }finally{
        if(active) setLoading(false);
      }

    }

    load();

    return()=>active=false;

  },[competition]);

  if(loading){

    return(
      <div className="text-center py-12 text-zinc-400">
        جاري تحميل المباريات...
      </div>
    );

  }

  if(matches.length===0){

    return(
      <div className="text-center py-16 text-zinc-500">
        لا توجد مباريات
      </div>
    );

  }

  return(

    <div className="space-y-4">

      {matches.map(match=>(

        <div
          key={match.fixture_id}
          className="rounded-3xl border border-white/10 bg-[#161616] p-5 hover:border-[#D4AF37]/50 transition"
        >

          <div className="flex justify-between items-center mb-4">

            <span className="text-[#D4AF37] text-sm font-bold">

              {match.league.round_ar || match.league.round_en}

            </span>

            <div className="flex items-center gap-2 text-zinc-400 text-sm">

              <CalendarDays size={16}/>

              {new Date(match.kickoff_utc).toLocaleString("ar")}

            </div>

          </div>

          <div className="grid grid-cols-[1fr_auto_1fr] items-center gap-4">

            <div className="text-center">

              <img
                src={match.teams.home.logo}
                className="w-12 h-12 mx-auto object-contain"
              />

              <div className="mt-2 font-bold">

                {match.teams.home.name_ar}

              </div>

            </div>

            <div className="text-center">

              <div className="text-2xl font-black text-[#D4AF37]">

                {match.goals.home ?? "-"}
                {" : "}
                {match.goals.away ?? "-"}

              </div>

              <div className="text-xs text-zinc-400 mt-1">

                {match.status.long}

              </div>

            </div>

            <div className="text-center">

              <img
                src={match.teams.away.logo}
                className="w-12 h-12 mx-auto object-contain"
              />

              <div className="mt-2 font-bold">

                {match.teams.away.name_ar}

              </div>

            </div>

          </div>

        </div>

      ))}

    </div>

  );

}
