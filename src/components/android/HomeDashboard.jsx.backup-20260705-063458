import { Link } from "react-router-dom";
import {
  CalendarDays,
  Trophy,
  Radio,
  Flame,
  ChevronLeft,
} from "lucide-react";

const cards = [
  { title: "ابدأ التوقع", desc: "توقع الآن", icon: Flame, to: "/matches", primary: true },
  { title: "المباريات", desc: "جميع المباريات", icon: CalendarDays, to: "/matches" },
  { title: "المتصدرون", desc: "ترتيب المشاركين", icon: Trophy, to: "/leaderboard" },
  { title: "التوقعات", desc: "توقعات المستخدمين", icon: Radio, to: "/user-predictions" },
];

export default function HomeDashboard() {
  return (
    <section className="px-4 pt-0 pb-8">
      <div className="grid grid-cols-2 gap-2">
        {cards.map((card) => {
          const Icon = card.icon;

          return (
            <Link
              key={card.title}
              to={card.to}
              className={
                card.primary
                  ? "h-20 rounded-lg bg-[#D4AF37] text-black px-2 py-2 flex flex-col justify-between shadow-lg"
                  : "h-20 rounded-lg bg-[#171717] border border-[#D4AF37]/15 px-2 py-2 flex flex-col justify-between"
              }
            >
              <div className="flex justify-between items-center">
                <Icon size={14} />
                {card.primary && <ChevronLeft size={12} />}
              </div>

              <div>
                <h3 className="text-sm font-black leading-none">
                  {card.title}
                </h3>

                <p className={card.primary ? "text-[9px] mt-1" : "text-[9px] text-zinc-400 mt-1"}>
                  {card.desc}
                </p>
              </div>
            </Link>
          );
        })}
      </div>
    </section>
  );
}
