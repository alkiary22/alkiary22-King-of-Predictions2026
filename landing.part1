import { useEffect, useState } from "react";
import { Crown, Trophy, TrendingUp, CalendarDays } from "lucide-react";

import { useAuth } from "../context/AuthContext";
import { useContent } from "../context/ContentContext";

import PushEnableBanner from "../components/PushEnableBanner";
import AdSlider from "../components/AdSlider";
import FeatureCard from "../components/landing/FeatureCard";
import HomeDashboard from "@/components/android/HomeDashboard";

const HERO_BG =
"https://static.prod-images.emergentagent.com/jobs/36ca7cb1-56bf-4cbb-a9df-d07fc64af674/images/cf694e18d81a1e3b6118c5df05310e8b849aa4f259b4293ec8caeb6d2c40b94f.png";

const WC_OPENING_UTC =
new Date("2026-06-11T19:00:00Z").getTime();

function getCountdown() {

const diff = Math.max(
0,
WC_OPENING_UTC - Date.now()
);

return {
days: Math.floor(diff / 86400000),
hours: Math.floor((diff % 86400000)/3600000),
minutes: Math.floor((diff % 3600000)/60000),
started: diff <= 0,
};

}

export default function Landing(){

const { user } = useAuth();
const { t } = useContent();

const [cd,setCd]=useState(getCountdown());

useEffect(()=>{

const id=setInterval(
()=>setCd(getCountdown()),
30000
);

return()=>clearInterval(id);

},[]);

return(

<div
className="min-h-screen bg-base text-white"
data-testid="landing-page"
>

<section className="relative overflow-hidden">

<div
className="absolute inset-0 bg-cover bg-center opacity-35"
style={{
backgroundImage:`url(${HERO_BG})`
}}
/>

<div className="absolute inset-0 bg-gradient-to-b from-black/30 via-black/70 to-black"/>

<div className="relative max-w-7xl mx-auto px-4 pt-3 pb-4">

<PushEnableBanner/>

<AdSlider/>

<div className="mx-auto max-w-md">

<div className="rounded-3xl bg-black/40 border border-[#D4AF37]/20 backdrop-blur-xl p-5">

<div className="flex justify-between items-center">

<div>

<p className="text-zinc-400 text-sm">
👋 أهلاً بعودتك
</p>

<h1 className="text-3xl font-black text-[#D4AF37] mt-1">
{user ? user.name : "ضيف"}
</h1>

